{
    "name": "mesh-fire-detection",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "vite --config config/build/vite.config.ts",
        "build": "vite build --config config/build/vite.config.ts",
        "preview": "vite preview --config config/build/vite.config.ts",
        "prepare": "husky",
        "check": "npm run check:types && npm run lint && npm test && npm run build",
        "check:types": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config config/build/vitest.config.ts",
        "test:watch": "vitest --config config/build/vitest.config.ts",
        "lint": "npm run lint:format && npm run lint:structure && npm run lint:js && npm run lint:css && npm run lint:deadcode",
        "lint:format": "prettier --config config/lint/.prettierrc --check . --log-level warn --ignore-path config/lint/.prettierignore",
        "lint:structure": "tsx config/lint/checkStructure.ts --strict",
        "lint:js": "eslint --config config/lint/eslint.config.mjs .",
        "lint:deadcode": "knip --config config/lint/knip.json",
        "lint:css": "stylelint \"src/**/*.css\" --config config/lint/stylelint.config.cjs --ignore-path config/lint/.stylelintignore",
        "fix": "npm run fix:format && npm run fix:js && npm run fix:css",
        "fix:format": "prettier --config config/lint/.prettierrc --write . --log-level warn --ignore-path config/lint/.prettierignore",
        "fix:js": "eslint --config config/lint/eslint.config.mjs . --fix",
        "fix:css": "stylelint \"src/**/*.css\" --fix --config config/lint/stylelint.config.cjs --ignore-path config/lint/.stylelintignore",
        "deps:updates": "npx npm-check-updates -u"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs,css,json,md,yml,yaml}": "prettier --config config/lint/.prettierrc --check --ignore-path config/lint/.prettierignore",
        "{src,config,tests}/**/*.{ts,tsx,js,mjs,cjs}": "eslint --config config/lint/eslint.config.mjs",
        "src/**/*.css": "stylelint --config config/lint/stylelint.config.cjs --ignore-path config/lint/.stylelintignore"
    },
    "dependencies": {
        "maplibre-gl": "^6.9.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.19.0",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.4.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^74.0.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "knip": "^6.35.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "prettier-plugin-css-order": "^2.2.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}

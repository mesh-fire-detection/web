{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/index.tsx",
        "tests/setup.ts",
        "tests/**/*.test.{ts,tsx}",
        "config/build/vite.config.ts",
        "config/build/vitest.config.ts",
        "config/lint/eslint.config.mjs",
        "config/lint/stylelint.config.cjs"
    ],
    "project": ["src/**/*.{ts,tsx}", "config/**/*.{ts,mjs,cjs}", "tests/**/*.{ts,tsx}"],
    "include": ["files", "exports", "types", "duplicates"],
    "ignoreIssues": {
        "src/components/shared/primitives/Layout.tsx": ["exports"],
        "src/components/shared/typography/Text.tsx": ["exports"]
    }
}
